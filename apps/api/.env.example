NODE_ENV=development
PORT=3001

# Postgres
DATABASE_URL=postgresql://connosr:connosr@localhost:5432/connosr

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=connosr-photos
S3_ACCESS_KEY_ID=connosr
S3_SECRET_ACCESS_KEY=connosr-secret
S3_FORCE_PATH_STYLE=true
# Leave unset to use presigned GET URLs; set once a CDN/public bucket is in front of storage.
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# CORS
WEB_ORIGIN=http://localhost:5173
