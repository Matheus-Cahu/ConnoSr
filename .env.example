# Root-level example. Copy this to apps/api/.env (and adjust) for local backend development.
# See apps/api/.env.example for the full list of backend variables.

# apps/web reads Vite-prefixed vars from apps/web/.env
VITE_API_URL=http://localhost:3001

# apps/mobile reads Expo-prefixed vars from apps/mobile/.env
EXPO_PUBLIC_API_URL=http://localhost:3001
